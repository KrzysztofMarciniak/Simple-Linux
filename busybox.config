# BusyBox 1.38.0 configuration fragment for SimpleLinux.
# Applied to allnoconfig; keep applets here when required by boot, shipped
# scripts, Ark, optional base services, development, or the base user interface.

CONFIG_BUSYBOX=y
CONFIG_LONG_OPTS=y

# Init, shell, login, and service support.
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
# Keep a per-user command history between shells.
CONFIG_FEATURE_EDITING_HISTORY=200
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_EDITING_SAVE_ON_EXIT=n
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=n
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_FEATURE_SH_HISTFILESIZE=y
CONFIG_SH_IS_ASH=y
CONFIG_LOGIN=y
CONFIG_LOGIN_SCRIPTS=y
CONFIG_SU=y
CONFIG_PASSWD=y
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_FEATURE_SUID=y
CONFIG_FEATURE_SUID_CONFIG=y
CONFIG_FEATURE_SUID_CONFIG_QUIET=y
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
CONFIG_USE_BB_CRYPT_YES=y
CONFIG_CRYPTPW=y
CONFIG_MKPASSWD=y
CONFIG_CROND=y
CONFIG_NTPD=y
CONFIG_PIDOF=y

# Boot, device management, and shutdown.
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_DAEMON=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FSTAB=y
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_UMOUNT=y
CONFIG_MKDIR=y
CONFIG_CAT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_SYNC=y
CONFIG_HOSTNAME=y

# Shipped service, account, and network scripts.
CONFIG_AWK=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_READLINK=y
CONFIG_TAIL=y
CONFIG_ID=y
CONFIG_KILL=y
CONFIG_IFCONFIG=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_ROUTE=y
CONFIG_UDHCPC=y
CONFIG_FEATURE_UDHCPC_ARPING=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_HTTPS=y
CONFIG_FEATURE_WGET_OPENSSL=y
CONFIG_NSLOOKUP=y
CONFIG_SLEEP=y
CONFIG_MKTEMP=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_AUTODETECT=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_SEAMLESS_BZ2=y
CONFIG_FEATURE_SEAMLESS_XZ=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_BZIP2=y
CONFIG_BUNZIP2=y
CONFIG_XZ=y
CONFIG_UNXZ=y
CONFIG_XZCAT=y

# Core interactive and maintenance commands; these are intentional user-facing
# conveniences, not boot dependencies.
CONFIG_LS=y
CONFIG_FEATURE_HUMAN_READABLE=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_COLOR=y
CONFIG_CP=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_LN=y
CONFIG_INSTALL=y
CONFIG_PWD=y
CONFIG_TOUCH=y
CONFIG_CLEAR=y
CONFIG_LESS=y
CONFIG_MORE=y
CONFIG_VI=y
# vi editor options; 8-bit display is enabled but is not Unicode-aware.
CONFIG_FEATURE_VI_MAX_LEN=4096
CONFIG_FEATURE_VI_8BIT=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_COLON_EXPAND=y
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_REGEX_SEARCH=n
CONFIG_FEATURE_VI_USE_SIGNALS=n
CONFIG_FEATURE_VI_DOT_CMD=y
CONFIG_FEATURE_VI_READONLY=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_SET=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_FEATURE_VI_ASK_TERMINAL=n
CONFIG_FEATURE_VI_UNDO=y
CONFIG_FEATURE_VI_UNDO_QUEUE=y
CONFIG_FEATURE_VI_UNDO_QUEUE_MAX=256
CONFIG_FEATURE_VI_VERBOSE_STATUS=n
CONFIG_FIND=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_FIND_DEPTH=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_SHRED=y
CONFIG_HEXDUMP=y
CONFIG_XXD=y
CONFIG_DF=y
CONFIG_DU=y
CONFIG_FREE=y
CONFIG_PS=y
CONFIG_TOP=y
CONFIG_DMESG=y
CONFIG_DATE=y
CONFIG_UNAME=y
CONFIG_WC=y
CONFIG_HEAD=y
CONFIG_CUT=y
CONFIG_SORT=y
CONFIG_XARGS=y
CONFIG_WHICH=y
CONFIG_STAT=y
CONFIG_SHA256SUM=y
CONFIG_DIFF=y
CONFIG_CMP=y
CONFIG_PATCH=y
CONFIG_BC=y
